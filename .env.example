NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# A random base64-encoded 32-byte key. Used only by the server to encrypt personal ICS links.
CONNECTEAM_ENCRYPTION_KEY=replace-with-a-random-base64-32-byte-key
# Telegram Bot API token. Keep this secret server-side; never use NEXT_PUBLIC_.
TELEGRAM_BOT_TOKEN=replace-with-your-bot-token
# A random, high-entropy value used to validate Telegram webhook requests.
TELEGRAM_WEBHOOK_SECRET=replace-with-a-random-webhook-secret
# Public HTTPS address registered as the Mini App URL in BotFather.
NEXT_PUBLIC_APP_URL=https://worklog-crm.vercel.app
